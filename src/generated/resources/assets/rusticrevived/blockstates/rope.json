{
  "multipart": [
    {
      "apply": {
        "model": "rusticrevived:block/rope"
      },
      "when": {
        "axis": "y"
      }
    },
    {
      "apply": {
        "model": "rusticrevived:block/rope_horizontal"
      },
      "when": {
        "axis": "z"
      }
    },
    {
      "apply": {
        "model": "rusticrevived:block/rope_horizontal",
        "y": 90
      },
      "when": {
        "axis": "x"
      }
    },
    {
      "apply": {
        "model": "rusticrevived:block/rope_dangle"
      },
      "when": {
        "axis": "z",
        "dangle": "true"
      }
    },
    {
      "apply": {
        "model": "rusticrevived:block/rope_dangle",
        "y": 90
      },
      "when": {
        "axis": "x",
        "dangle": "true"
      }
    },
    {
      "apply": {
        "model": "rusticrevived:block/rope_knot"
      },
      "when": {
        "axis": "z",
        "dangle": "true"
      }
    },
    {
      "apply": {
        "model": "rusticrevived:block/rope_knot",
        "y": 90
      },
      "when": {
        "axis": "x",
        "dangle": "true"
      }
    }
  ]
}